<Window x:Class="HarleySkinStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IcyFre Codex Studio"
        Width="1240"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="16"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis"/>

      <!-- 主题动态颜色资源 -->
      <SolidColorBrush x:Key="WindowBg" Color="#F8F9FA"/>
      <SolidColorBrush x:Key="PanelBg" Color="#80FFFFFF"/>
      <SolidColorBrush x:Key="PanelBorder" Color="#99FFFFFF"/>
      <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextPrimary" Color="#142538"/>
      <SolidColorBrush x:Key="TextSecondary" Color="#607789"/>
      <SolidColorBrush x:Key="ModalBg" Color="#F8F9FA"/>
      <SolidColorBrush x:Key="InputBg" Color="#99FFFFFF"/>
      <SolidColorBrush x:Key="InputBorder" Color="#88C4D4E0"/>

      <!-- 极细 4px 悬浮滚动条 -->
      <Style x:Key="MinimalScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#351B9AD0" CornerRadius="2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#701B9AD0"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBar}"/>

      <!-- 彻底解决 ListBox 禁用时变白框的专用 Style -->
      <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBox">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                  <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListBox" BasedOn="{StaticResource CleanListBoxStyle}"/>

      <!-- 幽灵透明按钮 Style -->
      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="12">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 现代 ComboBox 样式 -->
      <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0,28,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid x:Name="MainGrid">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                  <Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/>
                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border Background="Transparent"/>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </Grid>
                </Border>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                  <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                    <Border x:Name="DropDownBorder" Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,4">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.1" Color="#526C7E"/>
                      </Border.Effect>
                      <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="BorderBrush" Value="#1B9AD0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="MainGrid" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#201B9AD0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#301B9AD0"/>
                  <Setter Property="Foreground" Value="#1B9AD0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 系统控制按钮 -->
      <Style x:Key="SystemControlButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#20808080"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#30808080"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CloseControlButton" BasedOn="{StaticResource SystemControlButton}" TargetType="Button">
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#E54D42"/>
            <Setter Property="Foreground" Value="White"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- 胶囊通用按钮 -->
      <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#A7D0DCE8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PrimaryButton" BasedOn="{StaticResource PillButton}" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#00FFFFFF"/>
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#48C6EF" Offset="0"/>
              <GradientStop Color="#168FC8" Offset="1"/>
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#168FC8"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Foreground" Value="#E54D42"/>
        <Setter Property="Background" Value="#15E54D42"/>
        <Setter Property="BorderBrush" Value="#30E54D42"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#25E54D42"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 主页侧边栏主题列表 Style -->
      <Style x:Key="ThemeListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid>
                <Border x:Name="ItemChrome" CornerRadius="14" Padding="12" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1.5">
                  <ContentPresenter/>
                </Border>
                <Border x:Name="ActiveIndicator" Width="4" Height="20" CornerRadius="2" Background="#1B9AD0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#801B9AD0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#1B9AD0"/>
                  <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 弹窗全量库网格卡片 Style -->
      <Style x:Key="GalleryCardItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="CardChrome" CornerRadius="16" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Color="#304050"/>
                </Border.Effect>
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CardChrome" Property="BorderBrush" Value="#1B9AD0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="CardChrome" Property="BorderBrush" Value="#1B9AD0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource WindowBg}" CornerRadius="16" ClipToBounds="True">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 标题栏 -->
      <Grid x:Name="TitleBar" Grid.Row="0" Margin="20,0,12,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="12" Height="12" Fill="#FF6B6B" Margin="0,0,8,0"/>
          <Ellipse Width="12" Height="12" Fill="#FFD166" Margin="0,0,8,0"/>
          <Ellipse Width="12" Height="12" Fill="#70D77B" Margin="0,0,18,0"/>
          <TextBlock x:Name="AppTitleText" Text="IcyFre Codex Studio" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
          <TextBlock x:Name="AppSubtitleText" Text="  /  Codex 桌面主题实验室" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ThemeModeButton" Content="💻 跟随系统" Style="{StaticResource SystemControlButton}" Width="90" Margin="0,0,6,0" ToolTip="切换软件主题: 跟随系统 / 浅色 / 深色"/>
          <Button x:Name="LanguageButton" Content="EN" Style="{StaticResource SystemControlButton}" Width="42" Margin="0,0,4,0"/>
          <Button x:Name="MinimizeButton" Style="{StaticResource SystemControlButton}" ToolTip="最小化">
            <Path Data="M 0 0 L 10 0" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource SystemControlButton}" ToolTip="最大化 / 还原">
            <Path x:Name="MaximizeIcon" Data="M 0 0 L 9 0 L 9 9 L 0 9 Z" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseControlButton}" ToolTip="关闭">
            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 主内容区 -->
      <Grid Grid.Row="1" Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="336"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：主题库常用面板 -->
        <Border Grid.Column="0" CornerRadius="20" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" ClipToBounds="False">
          <Grid Margin="20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock x:Name="LibraryTitleText" Text="主题库" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock x:Name="LibraryDescriptionText" Text="导入一张图，自动生成浅色与深色 Codex 皮肤。" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,16,0,16" Height="90" CornerRadius="16" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource InputBg}">
              <Button x:Name="ImportButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="＋" FontSize="18" HorizontalAlignment="Center" Foreground="#1B9AD0"/>
                  <TextBlock x:Name="ImportTitleText" Text="导入图片生成主题" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                </StackPanel>
              </Button>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,10">
              <TextBlock x:Name="ThemeSectionText" Text="常用主题" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="OpenLibraryModalButton" Style="{StaticResource GhostButton}" Content="全部主题库 ↗" HorizontalAlignment="Right" Foreground="#1B9AD0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
            </Grid>

            <!-- 应用了自定义 CleanListBoxStyle，解决置灰变白块问题 -->
            <ListBox Grid.Row="3" x:Name="ThemeList" Style="{StaticResource CleanListBoxStyle}" ItemContainerStyle="{StaticResource ThemeListItemStyle}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="#DDF5FF">
                      <TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1B9AD0" FontSize="12"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="✓"
                               Foreground="#1B9AD0"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- 右侧：预览与设置 -->
        <Border Grid.Column="2" CornerRadius="20" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
          <Grid Margin="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="SelectedTitle" Text="未选择主题" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText" Text="已选择主题" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="10" Padding="10,6" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadgeText" Text="自动浅色 / 深色" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
              </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,12" VerticalAlignment="Center">
              <Grid x:Name="PreviewGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Light 浅色预览卡片 -->
                <Border CornerRadius="16" Background="#A0FFFFFF" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" ClipToBounds="True" MinHeight="260">
                  <Grid>
                    <!-- 1. 氛围模糊底图（完美填充空白，消除死板色块） -->
                    <Image Source="{Binding ElementName=LightPreview, Path=Source}" Stretch="UniformToFill" Opacity="0.45">
                      <Image.Effect>
                        <BlurEffect Radius="35" KernelType="Gaussian"/>
                      </Image.Effect>
                    </Image>

                    <!-- 2. 主预览图（100% 完整适应不裁切） -->
                    <Image x:Name="LightPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>

                    <!-- 无图时的提示 -->
                    <Border x:Name="LightEmpty" Background="#20FFFFFF">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LightEmptyTitleText" Text="浅色预览" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LightEmptyHintText" Text="导入主题后显示" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- 左上角 Tag 标签 -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="8" Background="#CCFFFFFF" Padding="8,4">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000"/>
                      </Border.Effect>
                      <TextBlock Text="Light" FontSize="11" FontWeight="Bold" Foreground="#333"/>
                    </Border>
                  </Grid>
                </Border>

                <!-- Dark 深色预览卡片 -->
                <Border Grid.Column="2" CornerRadius="16" Background="#CC252D38" BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True" MinHeight="260">
                  <Grid>
                    <!-- 1. 氛围模糊底图（完美填充空白） -->
                    <Image Source="{Binding ElementName=DarkPreview, Path=Source}" Stretch="UniformToFill" Opacity="0.4">
                      <Image.Effect>
                        <BlurEffect Radius="35" KernelType="Gaussian"/>
                      </Image.Effect>
                    </Image>

                    <!-- 2. 主预览图（100% 完整适应不裁切） -->
                    <Image x:Name="DarkPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>

                    <!-- 无图时的提示 -->
                    <Border x:Name="DarkEmpty" Background="#441F2730">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DarkEmptyTitleText" Text="深色预览" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock x:Name="DarkEmptyHintText" Text="自动生成暗色版本" Foreground="#BDD3E0" FontSize="12" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- 左上角 Tag 标签 -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="8" Background="#DD1C232B" Padding="8,4">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000"/>
                      </Border.Effect>
                      <TextBlock Text="Dark" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <Border Grid.Row="2" CornerRadius="16" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="16">
              <StackPanel>
                <TextBlock x:Name="FooterPrimaryText" Text="• 启动按钮会自动关闭已有 Codex，并以 CDP 模式重启。" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                <TextBlock x:Name="FooterSecondaryText" Text="• 应用主题会复制当前主题到 runtime/assets，并尝试热更新运行中的 Codex。" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,12"/>

                <Separator Background="{DynamicResource InputBorder}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="WelcomeTitleLabelText" Text="欢迎标题" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34">
                    <TextBox x:Name="WelcomeTitleBox" Text="我们该构建什么？" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontSize="12" Padding="10,0" VerticalContentAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="WelcomeCardsLabelText" Text="快捷卡图" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34">
                    <TextBlock x:Name="WelcomeCardsPathText" Text="沿用主题背景切片" Foreground="{DynamicResource TextSecondary}" FontSize="12" Padding="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="ChooseCardsImageButton" Content="选择" Style="{StaticResource GhostButton}" Padding="10,0" Height="34" Margin="0,0,4,0"/>
                    <Button x:Name="ClearCardsImageButton" Content="清除" Style="{StaticResource GhostButton}" Padding="10,0" Height="34"/>
                  </StackPanel>
                </Grid>

                <Grid Margin="70,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Height="58" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                    <Grid>
                      <Image x:Name="WelcomeCardPreview0" Stretch="UniformToFill" Opacity="0.38"/>
                      <Border Background="#9CFFFFFF"/>
                      <TextBlock Text="探索并理解代码" FontSize="10" FontWeight="SemiBold" Foreground="#1A242C" VerticalAlignment="Bottom" Margin="8"/>
                    </Grid>
                  </Border>

                  <Border Grid.Column="2" Height="58" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                    <Grid>
                      <Image x:Name="WelcomeCardPreview1" Stretch="UniformToFill" Opacity="0.38"/>
                      <Border Background="#9CFFFFFF"/>
                      <TextBlock Text="构建新功能、应用或工具" FontSize="10" FontWeight="SemiBold" Foreground="#1A242C" VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>

                  <Border Grid.Column="4" Height="58" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                    <Grid>
                      <Image x:Name="WelcomeCardPreview2" Stretch="UniformToFill" Opacity="0.38"/>
                      <Border Background="#9CFFFFFF"/>
                      <TextBlock Text="审查代码并提出修改建议" FontSize="10" FontWeight="SemiBold" Foreground="#1A242C" VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>

                  <Border Grid.Column="6" Height="58" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                    <Grid>
                      <Image x:Name="WelcomeCardPreview3" Stretch="UniformToFill" Opacity="0.38"/>
                      <Border Background="#9CFFFFFF"/>
                      <TextBlock Text="修复问题和失败" FontSize="10" FontWeight="SemiBold" Foreground="#1A242C" VerticalAlignment="Bottom" Margin="8"/>
                    </Grid>
                  </Border>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4">
                      <TextBlock x:Name="QualityLabelText" Text="图片质量" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <ComboBox x:Name="QualityPresetBox" Width="96" Style="{StaticResource ModernComboBox}" SelectedIndex="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBoxItem Tag="performance" Content="轻量"/>
                        <ComboBoxItem Tag="balanced" Content="均衡"/>
                        <ComboBoxItem Tag="fidelity" Content="高清"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4">
                      <TextBlock x:Name="EffectLabelText" Text="视觉效果" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <ComboBox x:Name="EffectPresetBox" Width="96" Style="{StaticResource ModernComboBox}" SelectedIndex="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBoxItem Tag="lite" Content="轻量"/>
                        <ComboBoxItem Tag="balanced" Content="均衡"/>
                        <ComboBoxItem Tag="rich" Content="磨砂"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                      <TextBlock x:Name="AccentLabelText" Text="主题色" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <ComboBox x:Name="AccentPresetBox" Width="100" Style="{StaticResource ModernComboBox}" SelectedIndex="0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBoxItem Tag="natural" Content="自然提取"/>
                        <ComboBoxItem Tag="sky" Content="天空蓝"/>
                        <ComboBoxItem Tag="mint" Content="薄荷绿"/>
                        <ComboBoxItem Tag="peach" Content="蜜桃粉"/>
                        <ComboBoxItem Tag="lilac" Content="雾紫"/>
                      </ComboBox>
                      <Border x:Name="AccentPreviewSwatch" Width="20" Height="20" CornerRadius="10" Margin="6,0,0,0" Background="#47A9D8" VerticalAlignment="Center" BorderBrush="#FFFFFF" BorderThickness="2"/>
                    </StackPanel>
                  </WrapPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,4,0,4">
                    <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Content="应用主题" Style="{StaticResource PillButton}" Margin="0,0,8,0"/>
                    <Button x:Name="LaunchButton" Content="启动 / 重启 Codex" Style="{StaticResource PrimaryButton}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- 4. 全量主题库画廊 Modal -->
      <Grid x:Name="LibraryModal"
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="999"
            Background="#70000000"
            Visibility="Collapsed"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Border Width="880"
                Height="580"
                CornerRadius="24"
                Background="{DynamicResource ModalBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.3" Color="#102030"/>
          </Border.Effect>
          <Grid Margin="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="完整主题库" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="ModalCountText" Text="(共 0 项)" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>

              <Border Grid.Column="1" HorizontalAlignment="Right" Width="220" Height="34" CornerRadius="10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Margin="0,0,16,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Path Data="M 12 12 L 16 16 M 13 7 A 5 5 0 1 1 3 7 A 5 5 0 0 1 13 7 Z"
                        Stroke="{DynamicResource TextSecondary}"
                        StrokeThickness="1.6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                  <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
              </Border>

              <Button x:Name="CloseModalButton" Grid.Column="2" Content="×" Style="{StaticResource SystemControlButton}" FontSize="18" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ListBox Grid.Row="1"
                     x:Name="ModalThemeList"
                     Style="{StaticResource CleanListBoxStyle}"
                     Foreground="{DynamicResource TextPrimary}"
                     ItemContainerStyle="{StaticResource GalleryCardItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>

              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Height="148">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="102"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="#E5EAEF">
                        <Image Source="{Binding LightPreview}" Stretch="UniformToFill"/>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="0,8,8,0" ClipToBounds="True" Background="#2A323D">
                        <Image Source="{Binding DarkPreview}" Stretch="UniformToFill"/>
                      </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="2,8,2,0">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

    </Grid>
  </Border>
</Window>
